# Copy to .env.local and fill in. Never commit .env.local.
#
# Everything here is optional. The data-access layer falls back to bundled
# sample content when these are absent, so a fresh clone still builds and
# renders every route — which is what makes CI and preview builds work
# without handing them secrets.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon/publishable key. Safe to expose to the browser; access
# is controlled by RLS, not by hiding the key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-only, never prefixed NEXT_PUBLIC_, and only needed
# if something bypasses RLS deliberately. Most marketing sites don't need it.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Site -------------------------------------------------------------------
# Canonical origin, used for sitemap, canonical tags and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Forms ------------------------------------------------------------------
# Where contact form submissions are emailed. Confirm this against the brief
# before launch — inheriting the old site's address is a common mistake.
# CONTACT_FORM_TO=
